# 이 파일은 "이 도구를 처음 세팅하는 사람"이 딱 한 번 채우는 값만 담습니다.
# Discord 봇 토큰/채널, Notion 키, Google 리프레시 토큰은 여기 넣지 마세요 —
# `npm run setup` 마법사가 브라우저에서 물어보고 data/config.json 에 저장합니다.

# ── Google Drive 공용 OAuth 클라이언트 (한 번만 발급, 여러 팀/설치가 재사용) ──
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (데스크톱 앱)
GOOGLE_APP_CLIENT_ID=
GOOGLE_APP_CLIENT_SECRET=
# setup 마법사가 뜨는 주소와 포트가 다르면 여기도 맞춰서 바꾸세요.
GOOGLE_APP_REDIRECT_URI=http://localhost:4600/auth/google/callback

# ── 선택 항목 ──────────────────────────────────────────
# 폴링 주기 (ms). 기본 2분
POLL_INTERVAL_MS=120000
# 설정 마법사가 뜨는 포트. 기본 4600
SETUP_PORT=4600
