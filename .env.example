# ── Discord ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ── 폴링 주기 (ms). 기본 2분 ──────────────────────────────
POLL_INTERVAL_MS=120000

# ── Google Drive (OAuth 2.0, 데스크톱 앱 클라이언트) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:53682/oauth2callback
# npm run google:authorize 실행 후 자동으로 채워짐 (직접 입력 X)
GOOGLE_REFRESH_TOKEN=

# ── Notion ────────────────────────────────────────────────
NOTION_API_KEY=
# 감시할 대상 ID를 쉼표로 구분 (하이픈 포함/미포함 모두 허용)
# 페이지 ID: 페이지 우측 상단 ... > Copy link 로 얻은 URL 끝부분
NOTION_PAGE_IDS=
# 데이터베이스 ID: 데이터베이스를 전체 화면으로 연 URL의 database_id 부분
NOTION_DATABASE_IDS=
