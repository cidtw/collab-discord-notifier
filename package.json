{
  "name": "collab-discord-notifier",
  "version": "2.0.0",
  "description": "Google Drive / Notion 문서 수정 사항을 폴링 감지해 Discord 채널로 알려주는 봇 (제로 의존성, Node 내장 기능만 사용)",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "node src/setupServer.js",
    "google:authorize": "node src/scripts/googleAuthorize.js"
  }
}
